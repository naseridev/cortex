<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Cortex"
    Manufacturer="$(Manufacturer)"
    Version="$(ProductVersion)"
    UpgradeCode="6F2D8A4E-3B71-4C9A-8E5D-1A7C94B20F63"
    Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Cortex" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="CortexExe" Source="$(BinaryPath)" KeyPath="yes" />
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
      </Component>
      <Component Id="Documentation">
        <File Id="ReadmeFile" Source="$(ReadmePath)" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Cortex" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>